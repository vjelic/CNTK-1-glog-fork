                  "snippet": {
                    "text": "strcpy(tempFile, msra::strfun::utf8(pageFilePath)",
                    "rendered": {
                      "text": "strcpy(tempFile, msra::strfun::utf8(pageFilePath)",
                      "markdown": "`strcpy(tempFile, msra::strfun::utf8(pageFilePath)`"
                    }
