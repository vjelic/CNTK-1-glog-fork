          "fixes": [
            {
              "description": {
                "text": "strcpy is frequently dangerous, as it will cause a buffer overflow if the source is larger than the destination."
              },
              "artifactChanges": [
                {
                  "artifactLocation": {
                    "uri": "Source/Readers/HTKMLFReader/HTKMLFReader.cpp"
                  },
                  "replacements": [
